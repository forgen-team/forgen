{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forgen.dev/schemas/forgen-rule-history.v1.schema.json",
  "title": "forgen-rule-history/v1",
  "description": "forgen status --history --json [--days N] [--rule id] 이 내는 룰별 하루 스냅숏(닫힌 날 보관값).",
  "type": "object",
  "required": ["schema", "generatedAt", "columns", "days"],
  "properties": {
    "schema": { "const": "forgen-rule-history/v1" },
    "generatedAt": { "type": "string" },
    "columns": {
      "type": "array",
      "items": { "type": "string" },
      "description": "행 칸 이름. 현재 값: id, status, phase, inject, violation, bypass."
    },
    "days": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["day", "asOf", "rows"],
        "properties": {
          "day": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "asOf": { "type": "string" },
          "rows": { "type": "array", "items": { "type": "array", "items": { "type": ["string", "number", "null"] } } }
        }
      }
    }
  }
}
