<?xml version="1.0" encoding="UTF-8"?>
<!--
  forgen audit inputs — 주간 자동 재측정(ROADMAP C2) launchd 예시. 이 파일은 예시일 뿐이며 저장소에 두기만 한다.

  하는 일: 매주 월요일 09:10(로컬 = KST)에 직전 완결 주(월~일)를 읽기 전용으로 세고
          ~/.forgen/audit/inputs/<그 주 월요일>.json 에 저장한다(모델 호출 없음, 대화 기록은 읽기만).
  등록(오너 승인 뒤에만):
    1) 아래 /Users/USERNAME 을 실제 홈으로 바꾼다.
    2) cp 이파일 ~/Library/LaunchAgents/com.forgen.audit-inputs.weekly.plist
    3) launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.forgen.audit-inputs.weekly.plist
  해제: launchctl bootout gui/$(id -u)/com.forgen.audit-inputs.weekly
  수동 확인: forgen audit inputs   (저장 없이 화면만)
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.forgen.audit-inputs.weekly</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-lc</string>
    <string>forgen audit inputs --save</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Weekday</key>
    <integer>1</integer>
    <key>Hour</key>
    <integer>9</integer>
    <key>Minute</key>
    <integer>10</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>/Users/USERNAME/.forgen/audit/inputs/launchd.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/USERNAME/.forgen/audit/inputs/launchd.err.log</string>
  <key>RunAtLoad</key>
  <false/>
  <key>LowPriorityIO</key>
  <true/>
  <key>Nice</key>
  <integer>10</integer>
</dict>
</plist>
